# .gitignore

# Ignore the virtual environment folder
venv/
env/
.env

# Ignore Python compiled files (the 'artifacts')
__pycache__/
*.pyc
*.pyo

# Ignore distribution/build files
*.egg-info/

# Ignore system files
.DS_Store

# Ignore your IDE settings (optional but good)
.vscode/

# Ignore the output maze files (so you don't commit 1000 txt files)
*.txt
!config.txt  # But DO keep the config.txt!
