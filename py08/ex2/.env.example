MATRIX_MODE=development
DATABASE_URL=database_url_here
API_KEY=api_key_here
LOG_LEVEL=DEBUG
ZION_ENDPOINT=zion_endpoint_here

# mode: development or production
# database_url_here: the URL to your database
# api_key_here: your API key for accessing the Matrix
# log_level: DEBUG, INFO, WARNING, ERROR
# zion_endpoint_here: the endpoint for accessing Zion's services
